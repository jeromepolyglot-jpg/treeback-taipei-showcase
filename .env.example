# Copy to .env and fill in with your own Lovable Cloud / Supabase project values.
# Publishable keys are safe to expose to the browser; never commit secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only (optional; only needed for the weekly AI summary job)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
